# Privy App ID for Web3 Authentication (get yours from https://dashboard.privy.io)
VITE_PRIVY_APP_ID=your_privy_app_id_here

# Solana Cluster & RPC URL (Devnet default)
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# MagicBlock Ephemeral Rollup Router & WebSocket RPC
VITE_MAGICBLOCK_ROUTER_URL=https://devnet.magicblock.app
VITE_EPHEMERAL_RPC_URL=wss://devnet.magicblock.app

# Anchor Program ID & Canvas Account PDA
VITE_PROGRAM_ID=PxraCanvas111111111111111111111111111111111
VITE_CANVAS_PDA=PxraCanvasPDA111111111111111111111111111111111
